<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sudoku 6x6</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #0b0e14;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      max-height: 100vh;
      font-family: 'Space Grotesk', sans-serif;
      padding: 0.5rem;
      margin: 0;
      overflow: hidden;
    }

    .sudoku-container {
      max-width: 480px;
      width: 100%;
      max-height: 98vh;
      background: #1a1f2b;
      padding: 1rem 1rem 0.8rem 1rem;
      border-radius: 32px;
      box-shadow: 0 15px 30px rgba(0,0,0,0.8), inset 0 0 0 1px #3b4455;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .title-88m {
      text-align: center;
      font-size: 1.8rem;
      font-weight: 900;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #c7d0de;
      text-shadow: 0 0 8px #4f6b8a, 0 0 20px #2d4055;
      margin-bottom: 0.1rem;
      font-family: 'Orbitron', sans-serif;
    }
    .title-88m small {
      font-size: 0.75rem;
      font-weight: 400;
      letter-spacing: 2px;
      color: #FBBF24;
      display: block;
      margin-top: -4px;
    }

    /* === BARRA SUPERIOR: números + nivel === */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #141c26;
      padding: 0.25rem 0.6rem;
      border-radius: 40px;
      border: 1px solid #314153;
      margin: 0.4rem 0;
      gap: 0.4rem;
    }

    .num-selector {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .num-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #1e2635;
      border: 1px solid #3b506b;
      color: #b7c9e6;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      transition: 0.1s;
      box-shadow: 0 2px 0 #0a0f17;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
    }
    .num-btn:hover {
      background: #2b364b;
      border-color: #6c8bb0;
      transform: scale(1.05);
    }
    .num-btn.active {
      background: #3b506e;
      border-color: #a3b9db;
      box-shadow: 0 0 10px #4f7bb3;
      color: #fff;
    }
    .num-btn.dragging {
      opacity: 0.5;
    }

    .level-display-top {
      font-size: 0.75rem;
      font-weight: 700;
      color: #c8daf5;
      background: #0b111a;
      padding: 0.15rem 0.6rem;
      border-radius: 30px;
      border: 1px solid #3d506b;
      letter-spacing: 1px;
      white-space: nowrap;
    }
    .level-display-top span {
      color: #f5c542;
    }

    /* === TABLERO === */
    .board-wrapper {
      background: #242c3b;
      padding: 0.6rem;
      border-radius: 28px;
      box-shadow: inset 0 4px 8px rgba(0,0,0,0.6), 0 6px 12px rgba(0,0,0,0.6);
      margin: 0.2rem 0;
    }

    .sudoku-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 4px;
      aspect-ratio: 1 / 1;
      background: #181e27;
      padding: 4px;
      border-radius: 20px;
      box-shadow: inset 0 0 0 1px #314153;
    }

    .cell {
      background: #2c3547;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 1.4rem;
      color: #d3def0;
      text-shadow: 0 0 6px #3c5170;
      transition: background 0.15s, box-shadow 0.15s;
      cursor: default;
      aspect-ratio: 1 / 1;
      box-shadow: inset 0 -2px 0 #0f131c, 0 2px 0 #3b455a;
      position: relative;
    }

    .cell.editable {
      background: #1e2635;
      color: #b7c9e6;
      cursor: pointer;
      box-shadow: inset 0 0 0 1px #3b506b, 0 2px 0 #1d2533;
    }
    .cell.editable:hover {
      background: #2b364b;
      box-shadow: inset 0 0 0 2px #6c8bb0, 0 2px 0 #1d2533;
    }
    .cell.fixed {
      background: #2f3b50;
      color: #e7edf7;
      font-weight: 900;
      text-shadow: 0 0 10px #6382aa;
    }
    .cell.user-input {
      color: #b3d0ff;
      text-shadow: 0 0 12px #4f7bb3;
    }
    .cell.drop-over {
      box-shadow: inset 0 0 0 3px #f5c542, 0 2px 0 #1d2533;
    }

    /* === BOTONES + ESTRELLAS === */
    .action-stars-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 6px;
      margin: 0.4rem 0 0.2rem 0;
    }

    .btn-group {
      display: flex;
      gap: 6px;
    }

    .btn {
      background: #202a3a;
      border: none;
      border-radius: 40px;
      padding: 0.35rem 0.6rem;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 0.65rem;
      letter-spacing: 0.5px;
      color: #ccddf7;
      box-shadow: 0 3px 0 #0a0f17;
      cursor: pointer;
      transition: 0.08s linear;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      border: 1px solid #40526b;
      white-space: nowrap;
    }
    .btn:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #0a0f17;
    }
    .btn-primary {
      background: #3b506e;
      color: #f0f6ff;
      border-color: #6782a8;
      box-shadow: 0 3px 0 #1d283b;
    }
    .btn-warning {
      background: #7a6a3a;
      border-color: #b8984a;
      color: #f7edc3;
      box-shadow: 0 3px 0 #4d3f22;
    }
    .btn-success {
      background: #2d6b4a;
      border-color: #4d9e6e;
      color: #daf5e3;
      box-shadow: 0 3px 0 #1a402c;
    }

    .stars-display {
      display: flex;
      align-items: center;
      gap: 3px;
      background: #111a24;
      padding: 0.2rem 0.6rem;
      border-radius: 40px;
      border: 1px solid #3d506b;
    }
    .star-icon {
      color: #f5c542;
      font-size: 1.1rem;
      line-height: 1;
      filter: drop-shadow(0 0 4px #f5b342);
    }
    .star-count {
      font-size: 0.95rem;
      font-weight: 700;
      color: #efd28e;
    }

    .msg-box {
      text-align: center;
      height: 1.8rem;
      font-size: 0.72rem;
      color: #b9cef0;
      padding: 0.1rem;
      margin-top: 0.2rem;
      background: #141c26;
      border-radius: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #314153;
    }

    @media (max-height: 650px) {
      .title-88m { font-size: 1.4rem; }
      .board-wrapper { padding: 0.4rem; }
      .cell { font-size: 1.2rem; }
      .num-btn { width: 28px; height: 28px; font-size: 0.85rem; }
    }
  </style>
</head>
<body>

<div class="sudoku-container">
  <div class="title-88m">
    SUDOKU
    <small>6x6</small>
  </div>

  <div class="top-bar">
    <div class="num-selector" id="numSelector">
      <button class="num-btn" data-num="1">1</button>
      <button class="num-btn" data-num="2">2</button>
      <button class="num-btn" data-num="3">3</button>
      <button class="num-btn" data-num="4">4</button>
      <button class="num-btn" data-num="5">5</button>
      <button class="num-btn" data-num="6">6</button>
    </div>
    <div class="level-display-top">NIVEL <span id="levelDisplayTop">1</span> / 50</div>
  </div>

  <div class="board-wrapper">
    <div class="sudoku-grid" id="sudokuGrid"></div>
  </div>

  <div class="action-stars-row">
    <div class="btn-group">
      <button class="btn btn-primary" id="resetBtn">⟳ REINICIAR</button>
      <button class="btn btn-warning" id="checkBtn">✔ VERIFICAR</button>
      <button class="btn btn-success" id="solveBtn">★ RESOLVER</button>
    </div>
    <div class="stars-display">
      <span class="star-icon">✦</span>
      <span class="star-count" id="starCountInline">0</span>
    </div>
  </div>

  <div class="msg-box" id="messageBox">✦ 50 reinos · selecciona un número y haz clic en una celda</div>
</div>

<script>
  (function() {
    const TOTAL_LEVELS = 50;
    const GRID_SIZE = 6;
    const BOX_ROWS = 2;
    const BOX_COLS = 3;

    let currentLevel = 0;
    let starCount = 0;
    let baseGrid = [];
    let puzzleGrid = [];
    let fixedMask = [];
    let userGrid = [];
    let cellElements = [];

    let selectedNum = 0;

    const gridEl = document.getElementById('sudokuGrid');
    const levelDisplayTop = document.getElementById('levelDisplayTop');
    const starCountInline = document.getElementById('starCountInline');
    const msgBox = document.getElementById('messageBox');
    const numBtns = document.querySelectorAll('.num-btn');

    // === SINTETIZADOR DE AUDIO (Web Audio API) ===
    let audioCtx = null;

    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // Sonido para nivel individual
    function playLevelSuccessSound() {
      try {
        const ctx = getAudioContext();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now); // C5
        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.15); // E5

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(now);
        osc.stop(now + 0.3);
      } catch (e) {
        console.log("Audio no soportado o bloqueado por el navegador");
      }
    }

    // Fanfarria completa al finalizar los 50 niveles
    function playAllCompletedSound() {
      try {
        const ctx = getAudioContext();
        const notes = [
          { f: 523.25, duration: 0.15, delay: 0 },     // C5
          { f: 659.25, duration: 0.15, delay: 0.15 },  // E5
          { f: 783.99, duration: 0.15, delay: 0.30 },  // G5
          { f: 1046.50, duration: 0.5, delay: 0.45 }   // C6
        ];

        notes.forEach(note => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const startTime = ctx.currentTime + note.delay;

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(note.f, startTime);

          gain.gain.setValueAtTime(0.4, startTime);
          gain.gain.exponentialRampToValueAtTime(0.01, startTime + note.duration);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(startTime);
          osc.stop(startTime + note.duration);
        });
      } catch (e) {
        console.log("Audio no soportado o bloqueado por el navegador");
      }
    }

    numBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        const num = parseInt(this.dataset.num, 10);
        if (selectedNum === num) {
          selectedNum = 0;
          this.classList.remove('active');
          msgBox.textContent = '✕ Modo borrar (clic en celda para vaciar)';
        } else {
          selectedNum = num;
          numBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          msgBox.textContent = `🔢 Número ${num} seleccionado · haz clic en una celda vacía`;
        }
      });

      btn.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', this.dataset.num);
        this.classList.add('dragging');
      });
      btn.addEventListener('dragend', function(e) {
        this.classList.remove('dragging');
      });
    });

    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function isValid(grid, row, col, num) {
      for (let i = 0; i < GRID_SIZE; i++) {
        if (grid[row][i] === num) return false;
        if (grid[i][col] === num) return false;
      }
      const startRow = Math.floor(row / BOX_ROWS) * BOX_ROWS;
      const startCol = Math.floor(col / BOX_COLS) * BOX_COLS;
      for (let i = startRow; i < startRow + BOX_ROWS; i++) {
        for (let j = startCol; j < startCol + BOX_COLS; j++) {
          if (grid[i][j] === num) return false;
        }
      }
      return true;
    }

    function solveSudoku(grid) {
      for (let row = 0; row < GRID_SIZE; row++) {
        for (let col = 0; col < GRID_SIZE; col++) {
          if (grid[row][col] === 0) {
            const nums = shuffleArray([1,2,3,4,5,6]);
            for (let n of nums) {
              if (isValid(grid, row, col, n)) {
                grid[row][col] = n;
                if (solveSudoku(grid)) return true;
                grid[row][col] = 0;
              }
            }
            return false;
          }
        }
      }
      return true;
    }

    function generateRandomSudoku() {
      const grid = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(0));
      solveSudoku(grid);
      return grid;
    }

    function createPuzzleFromSolution(solution, emptyCount = 12) {
      const puzzle = solution.map(row => [...row]);
      const fixed = Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(true));
      let removed = 0;
      const positions = [];
      for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
          positions.push([r, c]);
        }
      }
      shuffleArray(positions);
      for (let [r, c] of positions) {
        if (removed >= emptyCount) break;
        puzzle[r][c] = 0;
        fixed[r][c] = false;
        removed++;
      }
      return { puzzle, fixed };
    }

    function getLevelData(levelIndex) {
      let solution = null;
      let attempts = 0;
      while (attempts < 30) {
        const grid = generateRandomSudoku();
        if (grid.flat().every(v => v !== 0)) {
          solution = grid;
          break;
        }
        attempts++;
      }
      if (!solution) {
        solution = [
          [1,2,3,4,5,6],
          [4,5,6,1,2,3],
          [2,3,1,5,6,4],
          [5,6,4,2,3,1],
          [3,1,2,6,4,5],
          [6,4,5,3,1,2]
        ];
      }
      const emptyBase = 10 + Math.floor(levelIndex / 5) * 2;
      const emptyCount = Math.min(28, emptyBase + Math.floor(Math.random() * 4));
      const { puzzle, fixed } = createPuzzleFromSolution(solution, emptyCount);
      return { solution, puzzle, fixed };
    }

    function loadLevel(levelIndex) {
      if (levelIndex < 0) levelIndex = 0;
      if (levelIndex >= TOTAL_LEVELS) levelIndex = TOTAL_LEVELS - 1;
      currentLevel = levelIndex;

      const data = getLevelData(currentLevel);
      baseGrid = data.solution.map(row => [...row]);
      puzzleGrid = data.puzzle.map(row => [...row]);
      fixedMask = data.fixed.map(row => [...row]);
      userGrid = puzzleGrid.map(row => [...row]);

      renderGrid();
      updateInfo();
      msgBox.textContent = `✦ Nivel ${currentLevel+1} · selecciona un número y haz clic en una celda`;
      window._starEarnedThisLevel = false;
      numBtns.forEach(b => b.classList.remove('active'));
      selectedNum = 0;
    }

    function renderGrid() {
      gridEl.innerHTML = '';
      cellElements = [];
      for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
          const cell = document.createElement('div');
          cell.className = 'cell';
          const val = userGrid[r][c];
          if (val !== 0) {
            cell.textContent = val;
          } else {
            cell.textContent = '';
          }
          if (fixedMask[r][c]) {
            cell.classList.add('fixed');
          } else {
            cell.classList.add('editable');
            cell.addEventListener('click', (function(row, col) {
              return function(e) {
                handleCellClick(row, col);
              };
            })(r, c));

            cell.addEventListener('dragover', function(e) {
              e.preventDefault();
              this.classList.add('drop-over');
            });
            cell.addEventListener('dragleave', function(e) {
              this.classList.remove('drop-over');
            });
            cell.addEventListener('drop', (function(row, col) {
              return function(e) {
                e.preventDefault();
                this.classList.remove('drop-over');
                const numStr = e.dataTransfer.getData('text/plain');
                if (numStr) {
                  const num = parseInt(numStr, 10);
                  if (num >= 1 && num <= 6) {
                    setCellValue(row, col, num);
                  }
                }
              };
            })(r, c));
          }
          if (val !== 0 && !fixedMask[r][c]) {
            cell.classList.add('user-input');
          }
          gridEl.appendChild(cell);
          cellElements.push(cell);
        }
      }
    }

    function setCellValue(row, col, num) {
      if (fixedMask[row][col]) return;
      const current = userGrid[row][col];
      if (current === num) {
        num = 0;
      }
      userGrid[row][col] = num;
      const idx = row * GRID_SIZE + col;
      const cell = cellElements[idx];
      cell.textContent = num === 0 ? '' : num;
      if (num !== 0) {
        cell.classList.add('user-input');
      } else {
        cell.classList.remove('user-input');
      }
      msgBox.textContent = `✏️ Celda (${row+1}, ${col+1}) → ${num || 'vacío'}`;
    }

    function handleCellClick(row, col) {
      if (fixedMask[row][col]) return;
      const num = selectedNum;
      setCellValue(row, col, num);
    }

    function checkSolution() {
      let correct = true;
      for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
          if (userGrid[r][c] !== baseGrid[r][c]) {
            correct = false;
            break;
          }
        }
        if (!correct) break;
      }
      if (correct) {
        if (!window._starEarnedThisLevel) {
          starCount++;
          starCountInline.textContent = starCount;
          window._starEarnedThisLevel = true;
          highlightCells(true);

          if (currentLevel < TOTAL_LEVELS - 1) {
            playLevelSuccessSound();
            msgBox.textContent = `★ ¡CORRECTO! +1 estrella (total ${starCount}) → avance automático`;
            setTimeout(() => {
              loadLevel(currentLevel + 1);
            }, 800);
          } else {
            playAllCompletedSound();
            msgBox.textContent = `🏆 ¡Completaste los 50 niveles! Eres el rey del reino.`;
          }
        } else {
          msgBox.textContent = `✓ Ya ganaste la estrella de este nivel.`;
          highlightCells(true);
        }
      } else {
        msgBox.textContent = `✗ Aún no coincide con la solución. Sigue intentando.`;
        highlightCells(false);
      }
    }

    function highlightCells(ok) {
      const cells = document.querySelectorAll('.cell');
      cells.forEach((el, idx) => {
        const r = Math.floor(idx / GRID_SIZE);
        const c = idx % GRID_SIZE;
        if (userGrid[r][c] !== 0 && userGrid[r][c] === baseGrid[r][c]) {
          el.style.boxShadow = 'inset 0 0 0 2px #7bcb7b, 0 2px 0 #1d2533';
        } else if (userGrid[r][c] !== 0 && userGrid[r][c] !== baseGrid[r][c]) {
          el.style.boxShadow = 'inset 0 0 0 2px #d97a7a, 0 2px 0 #1d2533';
        } else {
          el.style.boxShadow = '';
        }
        setTimeout(() => {
          el.style.boxShadow = '';
        }, 1200);
      });
    }

    function solveCurrent() {
      for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
          if (!fixedMask[r][c]) {
            userGrid[r][c] = baseGrid[r][c];
          }
        }
      }
      renderGrid();
      msgBox.textContent = `★ Resuelto · Usa "Verificar" para obtener estrella y avanzar.`;
    }

    function resetLevel() {
      userGrid = puzzleGrid.map(row => [...row]);
      renderGrid();
      msgBox.textContent = `⟳ Reiniciado nivel ${currentLevel+1}`;
    }

    function updateInfo() {
      levelDisplayTop.textContent = currentLevel + 1;
      starCountInline.textContent = starCount;
    }

    function init() {
      window._starEarnedThisLevel = false;
      loadLevel(0);
      document.getElementById('resetBtn').addEventListener('click', resetLevel);
      document.getElementById('checkBtn').addEventListener('click', checkSolution);
      document.getElementById('solveBtn').addEventListener('click', solveCurrent);

      numBtns.forEach(btn => {
        btn.setAttribute('draggable', 'true');
      });
    }

    init();
  })();
</script>
</body>
</html>
