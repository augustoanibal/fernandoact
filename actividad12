<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EL DIPTONGO - Actividad Interactiva</title>
  <style>
    :root {
      --bg-color: #f7f9fc;
      --card-bg: #ffffff;
      --primary: #5c6bc0;
      --primary-light: #e8eaf6;
      --accent: #26a69a;
      --text-main: #37474f;
      --text-muted: #78909c;
      --success: #66bb6a;
      --border-color: #e0e0e0;
    }

    * {
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .container {
      max-width: 800px;
      width: 100%;
    }

    /* Header & Teoría */
    header {
      background-color: var(--card-bg);
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-bottom: 25px;
      border-top: 6px solid var(--primary);
    }

    h1 {
      color: var(--primary);
      text-align: center;
      letter-spacing: 2px;
      margin-bottom: 15px;
      font-size: 2em;
    }

    .theory-box {
      background-color: var(--primary-light);
      padding: 15px 20px;
      border-radius: 8px;
      margin-bottom: 15px;
    }

    .theory-box h3 {
      color: var(--primary);
      margin-bottom: 8px;
      font-size: 1.1em;
    }

    .instruction {
      font-size: 0.95em;
      color: var(--text-main);
      background: #fff8e1;
      padding: 12px 15px;
      border-left: 4px solid #ffca28;
      border-radius: 4px;
    }

    /* Ejercicios */
    .exercise-card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 15px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      border: 1px solid var(--border-color);
      transition: transform 0.2s ease;
    }

    .exercise-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .word-num {
      background: var(--primary-light);
      color: var(--primary);
      font-weight: bold;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      font-size: 0.9em;
    }

    .word-title {
      font-size: 1.2em;
      font-weight: bold;
      color: var(--text-main);
    }

    .input-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    input[type="text"] {
      padding: 10px 14px;
      border: 2px solid var(--border-color);
      border-radius: 6px;
      font-size: 1em;
      outline: none;
      transition: border-color 0.3s;
      width: 180px;
    }

    input[type="text"]:focus {
      border-color: var(--primary);
    }

    .combination-tag {
      background-color: #e0f2f1;
      color: #00695c;
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 0.9em;
      font-weight: bold;
      display: none;
      animation: fadeIn 0.4s ease-in-out forwards;
    }

    /* Paginación y Botones */
    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 25px;
      gap: 10px;
    }

    button, .btn-home {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.2s;
      text-decoration: none;
      display: inline-block;
      text-align: center;
    }

    button:hover, .btn-home:hover {
      background-color: #3f51b5;
    }

    button:disabled {
      background-color: #c5cae9;
      cursor: not-allowed;
    }

    .btn-home {
      background-color: var(--accent);
    }

    .btn-home:hover {
      background-color: #00897b;
    }

    .page-indicator {
      font-weight: bold;
      color: var(--text-muted);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

<div class="container">
  <header id="top">
    <h1>EL DIPTONGO</h1>
    
    <div class="theory-box">
      <h3>Definición:</h3>
      <p>Es la unión de dos vocales en una misma sílaba.</p>
      <br>
      <h3>Estructura:</h3>
      <p>Se forma combinando una <strong>vocal abierta (a, e, o)</strong> y una <strong>cerrada (i, u)</strong>, o dos <strong>cerradas distintas (iu, ui)</strong>.</p>
    </div>

    <div class="instruction">
      <strong>Indicación:</strong> Identifica el diptongo en cada palabra. Separa la palabra en sílabas utilizando guiones (ejemplo: <em>ai-re</em>). Al escribir la respuesta correcta, ¡descubrirás automáticamente la combinación de vocales!
    </div>
  </header>

  <!-- Contenedor dinámico de ejercicios -->
  <main id="quiz-container"></main>

  <!-- Paginador con botón de Inicio -->
  <div class="controls">
    <button id="prev-btn" onclick="changePage(-1)">Anterior</button>
    <a href="https://augustoanibal.github.io/fernandoact/index.html" class="btn-home">🏠 Inicio</a>
    <span class="page-indicator" id="page-indicator">Página 1 de 4</span>
    <button id="next-btn" onclick="changePage(1)">Siguiente</button>
  </div>
</div>

<script>
  // Datos de los 20 ejercicios con sus respuestas y combinaciones
  const exercises = [
    { word: "Aire", correct: "ai-re", combo: "a (abierta) + i (cerrada)" },
    { word: "Cielo", correct: "cie-lo", combo: "i (cerrada) + e (abierta)" },
    { word: "Fuego", correct: "fue-go", combo: "u (cerrada) + e (abierta)" },
    { word: "Ciudad", correct: "ciu-dad", combo: "i (cerrada) + u (cerrada)" },
    { word: "Cuidado", correct: "cui-da-do", combo: "u (cerrada) + i (cerrada)" },
    { word: "Peine", correct: "pei-ne", combo: "e (abierta) + i (cerrada)" },
    { word: "Puerta", correct: "puer-ta", combo: "u (cerrada) + e (abierta)" },
    { word: "Bailarina", correct: "bai-la-ri-na", combo: "a (abierta) + i (cerrada)" },
    { word: "Ruido", correct: "rui-do", combo: "u (cerrada) + i (cerrada)" },
    { word: "Tierra", correct: "tie-rra", combo: "i (cerrada) + e (abierta)" },
    { word: "Viento", correct: "vien-to", combo: "i (cerrada) + e (abierta)" },
    { word: "Causa", correct: "cau-sa", combo: "a (abierta) + u (cerrada)" },
    { word: "Hielo", correct: "hie-lo", combo: "i (cerrada) + e (abierta)" },
    { word: "Suelo", correct: "sue-lo", combo: "u (cerrada) + e (abierta)" },
    { word: "Triunfo", correct: "triun-fo", combo: "i (cerrada) + u (cerrada)" },
    { word: "Boina", correct: "boi-na", combo: "o (abierta) + i (cerrada)" },
    { word: "Abuelo", correct: "a-bue-lo", combo: "u (cerrada) + e (abierta)" },
    { word: "Lluvia", correct: "llu-via", combo: "i (cerrada) + a (abierta)" },
    { word: "Cuerda", correct: "cuer-da", combo: "u (cerrada) + e (abierta)" },
    { word: "Vicuña", correct: "vi-cu-ña", combo: "Ninguna (¡Ojo! Vicuña no tiene diptongo)" }
  ];

  let currentPage = 0;
  const itemsPerPage = 5;

  function renderPage() {
    const container = document.getElementById('quiz-container');
    container.innerHTML = '';

    const start = currentPage * itemsPerPage;
    const end = start + itemsPerPage;
    const currentExercises = exercises.slice(start, end);

    currentExercises.forEach((item, index) => {
      const globalIndex = start + index;
      const card = document.createElement('div');
      card.className = 'exercise-card';
      
      card.innerHTML = `
        <div class="exercise-header">
          <span class="word-num">${globalIndex + 1}</span>
          <span class="word-title">${item.word}</span>
        </div>
        <div class="input-group">
          <span>&rightarrow;</span>
          <input type="text" 
                 id="input-${globalIndex}" 
                 placeholder="Ej: sil-a-ba" 
                 oninput="checkAnswer(${globalIndex})"
                 autocomplete="off">
          <div id="combo-${globalIndex}" class="combination-tag">
            | Combinación: ${item.combo}
          </div>
        </div>
      `;
      container.appendChild(card);
    });

    // Actualizar indicador de página
    const totalPages = Math.ceil(exercises.length / itemsPerPage);
    document.getElementById('page-indicator').innerText = `Página ${currentPage + 1} de ${totalPages}`;
    
    // Estado de botones
    document.getElementById('prev-btn').disabled = currentPage === 0;
    document.getElementById('next-btn').disabled = currentPage === totalPages - 1;
  }

  function checkAnswer(index) {
    const input = document.getElementById(`input-${index}`);
    const comboTag = document.getElementById(`combo-${index}`);
    const userAnswer = input.value.trim().toLowerCase();
    const correctAnswer = exercises[index].correct.toLowerCase();

    if (userAnswer === correctAnswer) {
      input.style.borderColor = "var(--success)";
      input.style.backgroundColor = "#f1f8e9";
      comboTag.style.display = "inline-block";
    } else {
      input.style.borderColor = "var(--border-color)";
      input.style.backgroundColor = "white";
      comboTag.style.display = "none";
    }
  }

  function changePage(direction) {
    currentPage += direction;
    renderPage();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function goToHome() {
    window.location.href = "https://augustoanibal.github.io/fernandoact/index.html";
  }

  // Carga inicial
  renderPage();
</script>

</body>
</html>
